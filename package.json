{
  "name": "@walma-labs/elevenlabs-mcp",
  "version": "0.1.0",
  "description": "ElevenLabs MCP server for producing podcasts: multi-speaker dialogue, narration, music beds, sound effects and episode assembly with loudness normalisation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walma-Labs/elevenlabs-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "elevenlabs-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
